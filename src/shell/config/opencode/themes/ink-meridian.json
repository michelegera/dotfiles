      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "keyword": "$hue.purple.200"
    },
    "markdown": {
      "heading": "$hue.blue.200",
      "link": "$hue.purple.200",
      "image": "$hue.purple.200"
    }
  },
