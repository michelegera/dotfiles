# Ignore runtime-generated files
fish_variables

# Ignore all function files except custom ones
functions/*.fish
!functions/eza_git.fish
!functions/fisher.fish

# Ignore all completion files except fisher
completions/*.fish
!completions/fisher.fish

# Track root-level config files and conf.d
!.gitignore
!aliases.fish
!config.fish
!fish_plugins
!conf.d/
!conf.d/*.fish

# Ignore plugin conf.d files, which Fisher regenerates from fish_plugins.
# Their functions/ and completions/ counterparts are ignored above, so
# tracking them here would only half-vendor the plugin and drift on update.
conf.d/fish-eza.fish
conf.d/opah.fish
