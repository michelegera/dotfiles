{
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "comment": true,
    "editorconfig": true,
    "env": true,
    "fish": true,
    "graphql": true,
    "html": true,
    "ruby": true,
    "toml": true
  },
  "buffer_font_size": 12,
  "cli_default_open_behavior": "new_window",
  "icon_theme": {
    "dark": "Catppuccin Macchiato",
    "light": "Catppuccin Latte",
    "mode": "dark"
  },
  "markdown_preview": {
    "font_size": 12
  },
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "font_size": 12
  },
  "theme": "Catppuccin Mocha",
  "ui_font_size": 14
}
